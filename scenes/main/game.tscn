[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/main/game.gd" id="1_game"]
[ext_resource type="PackedScene" path="res://scenes/world/test_city.tscn" id="2_city"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://scenes/player/motorcycle.tscn" id="4_motor"]
[ext_resource type="PackedScene" path="res://scenes/player/follow_camera.tscn" id="5_cam"]
[ext_resource type="PackedScene" path="res://scenes/ui/hud.tscn" id="6_hud"]
[ext_resource type="Script" path="res://scenes/systems/booking_system.gd" id="7_booking"]

[node name="Game" type="Node3D"]
script = ExtResource("1_game")

[node name="World" parent="." instance=ExtResource("2_city")]

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="Motorcycle" parent="." instance=ExtResource("4_motor")]

[node name="CameraRig" parent="." instance=ExtResource("5_cam")]

[node name="HUD" parent="." instance=ExtResource("6_hud")]

[node name="BookingSystem" type="Node" parent="."]
script = ExtResource("7_booking")
