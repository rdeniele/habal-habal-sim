; Engine configuration file.
; Godot reads this to know how to run the game.
; Input actions are NOT defined here: see autoload/InputSetup.gd (easier to read and edit).

config_version=5

[application]

config/name="Habal-Habal Simulator"
config/description="Low-poly motorcycle-taxi rider simulator set in Bacolod City."
run/main_scene="res://scenes/main/game.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

InputSetup="*res://autoload/InputSetup.gd"
GameState="*res://autoload/GameState.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
